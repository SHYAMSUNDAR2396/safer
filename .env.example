# Run python3 scripts/bootstrap.py to create .env and local credentials.
APP_MODE=local
APP_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql+psycopg://safer:GENERATED@localhost:55432/safer
TEST_DATABASE_URL=postgresql+psycopg://safer:GENERATED@localhost:55432/safer_test
OIDC_ISSUER=http://localhost:8090/realms/safer
OIDC_CLIENT_ID=safer-web
SESSION_SECRET=GENERATED
POSTGRES_PASSWORD=GENERATED
KEYCLOAK_ADMIN_PASSWORD=GENERATED
S3_ENDPOINT=http://127.0.0.1:8333
S3_BUCKET=safer-documents
S3_ACCESS_KEY=safer-api
S3_SECRET_KEY=GENERATED
REDIS_PASSWORD=GENERATED
# Independent switch for the local rule-based explanation fallback (no LLM).
EXPLANATIONS_ENABLED=true

# Independent local case summaries; no model or external transfer.
SUMMARIES_ENABLED=true
# Optional advisory LLM remains off. Never put its API key here.
# LLM_MODE=off
# LLM_SYNTHETIC_EGRESS_APPROVED=false
# LLM_API_KEY_FILE=/absolute/private/location/gemini-key
# LLM_APPROVED_SOURCES_FILE=/absolute/private/location/approved-source-digests
# LLM_MONTHLY_BUDGET_MICROUSD=2000000
