# Run python3 scripts/bootstrap.py to create .env and local credentials.
APP_MODE=local
APP_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql+psycopg://safer:GENERATED@localhost:55432/safer
TEST_DATABASE_URL=postgresql+psycopg://safer:GENERATED@localhost:55432/safer_test
OIDC_ISSUER=http://localhost:8090/realms/safer
OIDC_CLIENT_ID=safer-web
SESSION_SECRET=GENERATED
POSTGRES_PASSWORD=GENERATED
KEYCLOAK_ADMIN_PASSWORD=GENERATED
S3_ENDPOINT=http://127.0.0.1:8333
S3_BUCKET=safer-documents
S3_ACCESS_KEY=safer-api
S3_SECRET_KEY=GENERATED
